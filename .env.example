# Copy to .env and adjust for your network before `docker compose up -d`.

# Kokoro TTS endpoint. In the co-located TrueNAS deployment both stacks share
# the external kokoro-net network, so the allowlist proxy is addressed by
# container name. On a split-host setup, use the Kokoro host's LAN IP instead
# (e.g. http://192.168.x.x:8881).
KOKORO_BASE_URL=http://kokoro-proxy:8881

# Paths inside the voicematchr-service container (backed by the ./data mount).
DB_PATH=/data/voicematchr.db
RECORDINGS_DIR=/data/recordings

# Origins allowed by the API's CORS middleware. In the composed deployment
# nginx serves the frontend and /api/ from one origin, so this only matters
# for non-same-origin setups; include the public hostname when tunneled.
CORS_ALLOW_ORIGINS=https://voicematchr.fiestaszn.com

# Connector token from Cloudflare Zero Trust -> Networks -> Tunnels. Leave
# unset to run the stack LAN-only; the cloudflared container will restart
# until a valid token is supplied.
CLOUDFLARE_TUNNEL_TOKEN=
